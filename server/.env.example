# copy to server/.env.local (dev) or server/.env.production and fill in

# server
PORT=3000
DB_URL=mongodb://127.0.0.1:27017/portfolio
FRONTEND_URL=http://localhost:5173

# auth
JWT_TOKEN=change-me-to-a-long-random-secret

# admin seed (npm run seed:admin)
ADMIN_NAME=Shahariar
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# contact mail — sent via Gmail SMTP using the inbox's own account. Gmail
# requires an App Password (not your regular password): Google Account ->
# Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
# inbox that receives contact-form messages — same as SMTP_USER for Gmail
EMAIL_ADDRESS=you@gmail.com

# cloudinary (post image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
